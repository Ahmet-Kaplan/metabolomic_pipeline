<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | e }}</title>

<!-- plotly.js via CDN: loaded once for all embedded figures -->
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>

<style>
  :root {
    --fg: #222;
    --muted: #666;
    --bg: #ffffff;
    --bg-soft: #f7f7f7;
    --accent: #0072B2;
    --border: #d8d8d8;
    --max-width: 1100px;
    --sidebar-width: 230px;
  }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: "Times New Roman", Times, serif;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.55;
    font-size: 14px;
  }
  header.report-header {
    background: linear-gradient(180deg, #f8fafd 0%, #eef2f7 100%);
    border-bottom: 1px solid var(--border);
    padding: 24px 40px 20px;
  }
  header.report-header h1 {
    margin: 0 0 6px;
    font-size: 22px;
    color: #111;
  }
  header.report-header .meta {
    color: var(--muted);
    font-size: 12px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  .path-chain {
    margin-top: 10px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 13px;
  }
  .path-chain .step {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 7px;
    margin-right: 4px;
    color: #333;
  }
  .path-chain .arrow { color: var(--muted); margin: 0 2px; }
  .layout {
    display: flex;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
  }
  nav.sidebar {
    width: var(--sidebar-width);
    flex: 0 0 auto;
    border-right: 1px solid var(--border);
    padding: 20px 12px 20px 0;
    position: sticky;
    top: 0;
    align-self: flex-start;
    height: 100vh;
    overflow-y: auto;
    font-size: 13px;
  }
  nav.sidebar h3 {
    margin: 0 0 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  nav.sidebar a {
    display: block;
    padding: 4px 8px;
    color: var(--fg);
    text-decoration: none;
    border-radius: 4px;
  }
  nav.sidebar a:hover { background: var(--bg-soft); color: var(--accent); }
  main.content {
    flex: 1 1 auto;
    padding: 24px 0 24px 24px;
    min-width: 0;
  }
  section.report-section {
    margin-bottom: 56px;
    scroll-margin-top: 16px;
  }
  section.report-section h2 {
    font-size: 18px;
    color: #111;
    margin: 0 0 4px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--accent);
  }
  section.report-section .method-line {
    color: var(--muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 12px;
    margin-bottom: 10px;
  }
  section.report-section .description {
    color: #444;
    margin-bottom: 14px;
  }
  details.params {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 12px;
    margin-bottom: 14px;
    font-size: 12px;
  }
  details.params summary {
    cursor: pointer;
    color: var(--muted);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  details.params table { margin-top: 6px; }
  table.kv {
    border-collapse: collapse;
    font-size: 12px;
  }
  table.kv td { padding: 2px 12px 2px 0; vertical-align: top; }
  table.kv td:first-child { color: var(--muted); }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 8px 0 18px;
  }
  .metric {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 14px;
    min-width: 130px;
  }
  .metric .name {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .metric .value {
    font-size: 18px;
    color: #111;
    font-weight: 600;
    font-feature-settings: "tnum" 1;
  }
  .metric .unit { font-size: 11px; color: var(--muted); margin-left: 3px; }
  .metric .description { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .figure-block {
    margin: 18px 0 28px;
    padding: 12px 14px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
  }
  .figure-block .fig-title {
    font-weight: 600;
    color: #111;
    margin-bottom: 4px;
  }
  .figure-block .fig-metric {
    color: var(--accent);
    font-size: 12px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    margin-bottom: 10px;
  }
  .figure-block .fig-caption {
    color: #555;
    font-size: 12.5px;
    margin-top: 8px;
    font-style: italic;
  }
  .figure-block .fig-links {
    margin-top: 6px;
    font-size: 11px;
  }
  .figure-block .fig-links a {
    color: var(--muted);
    text-decoration: none;
    margin-right: 12px;
  }
  .figure-block .fig-links a:hover { color: var(--accent); }
  table.report-table {
    border-collapse: collapse;
    margin-top: 6px;
    font-size: 12px;
    background: #fff;
  }
  table.report-table th, table.report-table td {
    padding: 4px 10px;
    border: 1px solid var(--border);
    text-align: left;
  }
  table.report-table th {
    background: var(--bg-soft);
    font-weight: 600;
    color: #222;
  }
  .table-block {
    margin: 18px 0 28px;
    padding: 12px 14px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
  }
  .table-block .tbl-title {
    font-weight: 600;
    color: #111;
    margin-bottom: 6px;
  }
  .table-block .tbl-caption {
    color: #555;
    font-size: 12px;
    font-style: italic;
    margin-top: 6px;
  }
  .table-block .truncation-note {
    color: var(--muted);
    font-size: 11px;
    margin-top: 4px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  footer.report-footer {
    border-top: 1px solid var(--border);
    margin-top: 40px;
    padding: 16px 40px;
    color: var(--muted);
    font-size: 11px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
</style>
</head>
<body>

<header class="report-header">
  <h1>{{ title | e }}</h1>
  <div class="meta">
    multiverse landing index · generated {{ created_at }} ·
    {{ n_sections }} sections · {{ n_figures }} figures
  </div>
  {% if path_chain %}
  <div class="path-chain">
    <span style="color: var(--muted); margin-right: 6px;">axes varied:</span>
    {% for step in path_chain -%}
      <span class="step">{{ step | e }}</span>
      {%- if not loop.last %}<span class="arrow">·</span>{% endif %}
    {%- endfor %}
  </div>
  {% endif %}
</header>

<div class="layout">

<nav class="sidebar">
  <h3>Sections</h3>
  {% for sec in sections -%}
    <a href="#{{ sec.name | e }}">{{ sec.title | e }}</a>
  {%- endfor %}
</nav>

<main class="content">
{% for sec in sections %}
<section class="report-section" id="{{ sec.name | e }}">
  <h2>{{ sec.title | e }}</h2>

  {% if sec.method or sec.description -%}
  <div class="method-line">
    {%- if sec.method %}method = {{ sec.method | e }}{% endif -%}
  </div>
  {%- endif %}

  {% if sec.description %}
  <div class="description">{{ sec.description | e }}</div>
  {% endif %}

  {% if sec.parameters %}
  <details class="params">
    <summary>parameters used</summary>
    <table class="kv">
      {% for k, v in sec.parameters.items() %}
      <tr><td>{{ k | e }}</td><td>{{ v | e }}</td></tr>
      {% endfor %}
    </table>
  </details>
  {% endif %}

  {% if sec.metrics %}
  <div class="metrics">
    {% for m in sec.metrics %}
    <div class="metric">
      <div class="name">{{ m.name | e }}</div>
      <div class="value">{{ m.value | e }}{% if m.unit %}<span class="unit">{{ m.unit | e }}</span>{% endif %}</div>
      {% if m.description %}<div class="description">{{ m.description | e }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% for fig in sec.figures %}
  <div class="figure-block" id="{{ fig.slug | e }}-block">
    <div class="fig-title">{{ fig.title | e }}</div>
    {% if fig.method_metric %}<div class="fig-metric">{{ fig.method_metric | e }}</div>{% endif %}
    {{ fig.inline_html | safe }}
    {% if fig.caption %}<div class="fig-caption">{{ fig.caption | e }}</div>{% endif %}
    <div class="fig-links">
      <a href="{{ fig.html_relpath | e }}" target="_blank">↗ open interactive</a>
      <a href="{{ fig.png_relpath | e }}" target="_blank">⬇ PNG</a>
    </div>
  </div>
  {% endfor %}

  {% for tbl in sec.tables %}
  <div class="table-block">
    <div class="tbl-title">{{ tbl.title | e }}</div>
    {{ tbl.html | safe }}
    {% if tbl.truncated %}
    <div class="truncation-note">showing first {{ tbl.n_rows_shown }} of {{ tbl.n_rows_total }} rows</div>
    {% endif %}
    {% if tbl.caption %}<div class="tbl-caption">{{ tbl.caption | e }}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endfor %}
</main>

</div>

<footer class="report-footer">
  Biomarker-Discovery-Only MLOps · multiverse landing index · Steegen 2016 / Simonsohn 2020
</footer>

</body>
</html>
